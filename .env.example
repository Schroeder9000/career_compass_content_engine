# ── Required ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Webflow CMS publishing ────────────────────────────────────────────────────
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=
WEBFLOW_COLLECTION_ID=
WEBFLOW_AUTHOR_ID=
WEBFLOW_CATEGORY_ID=

# ── Google Search Console + Analytics (optional but recommended) ──────────────
# Path to a Google Cloud service account JSON key file.
# The same key can be used for both GSC and GA4 — grant it access to each property.
# GSC: add service account email as a Viewer in Search Console → Settings → Users
# GA4: add service account email as a Viewer in GA4 Admin → Account Access Management
GSC_SERVICE_ACCOUNT_JSON=/path/to/your/service_account.json

# The verified property URL in GSC (must match exactly, including trailing slash).
GSC_SITE_URL=https://yoursite.com/

# Your GA4 numeric property ID (found in GA4 Admin → Property Settings).
GA4_PROPERTY_ID=123456789

# ── Serper.dev (optional — real-time SERP competitive data) ──────────────────
# Sign up free at https://serper.dev/ — provides live Google SERP results.
SERPER_API_KEY=

# ── Modal (optional — for serverless deployment) ──────────────────────────────
MODAL_SECRET_NAME=

